# Copy to .env and fill in. Used by the MCP server only.
# The service-role key bypasses row level security -- keep it on your machine,
# never in a client app or a committed file.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The account whose transcripts this server serves. Find it in the Supabase
# dashboard under Authentication -> Users.
SCRIBE_USER_ID=
